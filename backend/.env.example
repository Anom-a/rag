# Mongo
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=rag
MONGO_COLLECTION=models

# Admin auth (required)
ADMIN_USERNAME=ethiorobotics_admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN_TTL_MINUTES=60

# Embedding provider
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_ENDPOINT=https://api.voyageai.com/v1/embeddings
EMBEDDING_MODEL=voyage-large-2

# Groq LLM (required)
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Prompt and retrieval behavior
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant for Ethio Robotics staff users. Always refer to the company as "Ethio Robotics" and never abbreviate it. Use only provided context and answer clearly.
CHAT_TOP_K=4
MIN_VECTOR_SCORE=0.8

# Runtime hardening
HTTP_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=1048576
ALLOW_PROMPT_OVERRIDE=false

# Chat controls
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_HISTORY_CHARS=8000
CHAT_RATE_LIMIT_PER_MIN=5
CHAT_RATE_WINDOW_SECONDS=60
