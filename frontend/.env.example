# Backend API base URL. Leave unset (or "/") to serve from the same origin
# as the built frontend (the Go binary embeds/serves ./static).
VITE_API_URL=http://localhost:8080

# --- Branding ---------------------------------------------------------------
# Every value below is optional. When unset, the generic fallbacks defined in
# src/config/app.js are used, so a reskinned deployment only needs to provide
# VITE_APP_NAME and optionally VITE_APP_KEY.

# Product / app display name.
VITE_APP_NAME=Nexus

# Short machine-safe slug used to namespace localStorage keys
# (e.g. "acme.conversations.v1"). Defaults to a slugified VITE_APP_NAME.
VITE_APP_KEY=nexus

# Short tagline, e.g. "Intelligent RAG Assistant".
VITE_APP_TAGLINE=Intelligent RAG Assistant

# Long-form description used for the HTML meta description.
VITE_APP_DESCRIPTION=Nexus — an intelligent RAG assistant over your documents.

# 1-3 character avatar initials shown in the assistant footer.
VITE_APP_INITIALS=NX

# Name the assistant introduces itself with (defaults to VITE_APP_NAME).
VITE_APP_ASSISTANT=Nexus